#!/bin/sh
# Pre-push hook: blocks push if the test suite isn't fully green.
#
# Enable once with:
#   git config core.hooksPath .githooks
#
# Bypass for a known-broken WIP push (NOT for releases):
#   git push --no-verify
# The --no-verify flag is the only escape hatch. Use it sparingly and never
# for branches that feed into a release.

set -e

echo "[pre-push] running unit + integration tests before push..."

# Run from this script's directory so it works regardless of where the user
# invoked git push from.
cd "$(dirname "$0")/.."

# Default pyproject addopts skip slow/e2e. That's the gate we want for every
# push, fast feedback. e2e is reserved for explicit release runs.
if ! python -m pytest -q --tb=short; then
    echo ""
    echo "[pre-push] TESTS FAILED - push aborted."
    echo "[pre-push] Either fix the failure or use 'git push --no-verify' if"
    echo "[pre-push] you really know what you're doing (NOT for release branches)."
    exit 1
fi

# The invisible-core== specifier in pyproject.toml must name the version the
# core checkout actually builds. The core's version is derived from its release
# seal, so it moves on its own when a new engine is rolled in; this pin does
# not. Checked here because a wrong pin is not visible to the test suite: it
# only shows up at install time, on someone else's machine.
#
# The checker lives in the local workbench, one level above this checkout, and
# is not part of this repository. It used to be wrapped in a bare
# `if [ -f "$PIN_CHECK" ]`, which skipped with NO output and then fell through
# to a line reading "all tests green - push proceeding". Renaming or moving the
# workbench, or pushing from a worktree at a different depth, disarmed the gate
# and printed something that looks exactly like success. A gate that cannot run
# is now a refusal, and the only way past it is to say so out loud.
PIN_CHECK="${INVISIBLE_PIN_CHECK:-../../scripts/sync_core_pin.py}"
PIN_SKIPPED=""

if [ "$INVISIBLE_PIN_CHECK" = "skip" ]; then
    echo ""
    echo "[pre-push] ###################################################################"
    echo "[pre-push] # WARNING: INVISIBLE_PIN_CHECK=skip                               #"
    echo "[pre-push] # The invisible-core pin was NOT compared against the core. If it #"
    echo "[pre-push] # is stale, every install of this package resolves a core it was  #"
    echo "[pre-push] # never tested against, and no test downstream can see it.        #"
    echo "[pre-push] ###################################################################"
    echo ""
    PIN_SKIPPED=yes
elif [ ! -f "$PIN_CHECK" ]; then
    echo "" >&2
    echo "[pre-push] REFUSED - the invisible-core pin gate is not reachable." >&2
    echo "[pre-push]   looked for: $PIN_CHECK" >&2
    echo "[pre-push]   from:       $(pwd)" >&2
    echo "[pre-push] The workbench moved, or this is a clone/worktree at another" >&2
    echo "[pre-push] depth. Point INVISIBLE_PIN_CHECK at sync_core_pin.py, or push" >&2
    echo "[pre-push] with INVISIBLE_PIN_CHECK=skip to state on the record that the" >&2
    echo "[pre-push] pin is going out unchecked." >&2
    exit 1
else
    # The gate's own known-bad cases, before the gate's verdict is trusted. They
    # live next to it and take about a second. Nothing else in either repo runs
    # them, so without this they are 18 cases that execute when a human
    # remembers - which is a runbook note wearing a gate's clothes, the same
    # shape as the silent skip above.
    PIN_TESTS="$(dirname "$PIN_CHECK")/test_sync_core_pin.py"
    if [ ! -f "$PIN_TESTS" ]; then
        echo "" >&2
        echo "[pre-push] REFUSED - $PIN_TESTS is missing, so the pin gate is" >&2
        echo "[pre-push] unverified. A gate that has only ever printed PASS is not a" >&2
        echo "[pre-push] gate; do not trust this one until its own cases run." >&2
        exit 1
    fi
    echo "[pre-push] running the pin gate's own known-bad cases..."
    if ! PIN_TEST_OUT="$(python "$PIN_TESTS" 2>&1)"; then
        echo "$PIN_TEST_OUT" >&2
        echo "" >&2
        echo "[pre-push] REFUSED - the pin gate's own test suite is RED, so its" >&2
        echo "[pre-push] verdict on the pin means nothing. Fix $PIN_TESTS first." >&2
        exit 1
    fi
    echo "[pre-push]   $(echo "$PIN_TEST_OUT" | tail -n 1)"

    echo "[pre-push] checking the invisible-core pin..."
    if ! python "$PIN_CHECK" --check; then
        echo ""
        echo "[pre-push] the invisible-core pin does not match the core - push aborted."
        echo "[pre-push] Fix it with: python $PIN_CHECK"
        exit 1
    fi
fi

# ── forbidden names ────────────────────────────────────────────────────
# Naming a protection vendor or a target site in a public repo is a legal and
# credibility problem, and no test in this package covers it. It cannot be a
# test here either: the scanner needs a word list that deliberately lives
# outside every public repo.
#
# THREE cases, kept apart on purpose. The first cut of this had only two and
# refused whenever the script was not at the default path - which meant every
# clone of the PUBLIC repo was blocked on every push with no way to comply
# except switching the gate off. That is the same "red by default, so people
# route around it" failure the guard was moved out of the test suite to avoid.
#
#   configured (INVISIBLE_NAME_CHECK set) but unreachable -> REFUSE. Somebody
#       meant this to run and it did not.
#   present at the default path                           -> RUN, refuse on any
#       non-zero: the script exits 2 rather than 0 when it could not scan.
#   neither                                               -> this is not the
#       workbench; there is no word list here and nothing to enforce. Say so in
#       one line and carry on. Silence would be the actual failure.
NAME_CHECK="${INVISIBLE_NAME_CHECK:-../../scripts/check_forbidden_names.py}"
NAME_SKIPPED=""

if [ "$INVISIBLE_NAME_CHECK" = "skip" ]; then
    echo ""
    echo "[pre-push] ###################################################################"
    echo "[pre-push] # WARNING: INVISIBLE_NAME_CHECK=skip                              #"
    echo "[pre-push] # Nothing checked this push for vendor or target-site names. If   #"
    echo "[pre-push] # one is in the diff it is public the moment this lands, and a    #"
    echo "[pre-push] # force-push does not remove it - GitHub keeps the object.        #"
    echo "[pre-push] ###################################################################"
    echo ""
    NAME_SKIPPED=yes
elif [ -n "$INVISIBLE_NAME_CHECK" ] && [ ! -f "$NAME_CHECK" ]; then
    echo "" >&2
    echo "[pre-push] REFUSED - INVISIBLE_NAME_CHECK is set but points at nothing." >&2
    echo "[pre-push]   looked for: $NAME_CHECK" >&2
    echo "[pre-push]   from:       $(pwd)" >&2
    echo "[pre-push] Fix the path, or set INVISIBLE_NAME_CHECK=skip to state on the" >&2
    echo "[pre-push] record that this push is going out unscanned." >&2
    exit 1
elif [ ! -f "$NAME_CHECK" ]; then
    echo "[pre-push] no forbidden-name word list here, so nothing scanned this push."
    echo "[pre-push] (that scan is a maintainer gate; it lives outside this repo.)"
    NAME_SKIPPED=yes
else
    # git feeds the refs being pushed on stdin, one line per ref:
    #   "<local ref> <local sha> <remote ref> <remote sha>"
    # Read here because this is the only gate that needs it, and guarded on a
    # tty so that running the hook by hand does not hang waiting for input.
    if [ -t 0 ]; then
        PUSH_REFS=""
    else
        PUSH_REFS="$(cat)"
    fi

    # An all-zero REMOTE sha means the remote has never seen this branch, so
    # there is no old..new to take: everything not already on a remote is new.
    # An all-zero LOCAL sha is a branch deletion, which pushes no content.
    RANGE=""
    if [ -n "$PUSH_REFS" ]; then
        RANGE=$(printf '%s
' "$PUSH_REFS" | awk '
            $2 ~ /^0+$/ { next }
            $4 ~ /^0+$/ { print $2 " --not --remotes"; exit }
                        { print $4 ".." $2; exit }')
    fi

    run_name_check() {
        if [ -n "$RANGE" ]; then
            python "$NAME_CHECK" . --range "$RANGE"
        else
            python "$NAME_CHECK" .
        fi
    }

    # The gate on the gate. Nothing tested the scanner until 2026-07-27, and it
    # was returning a clean verdict over three of the four surfaces a public
    # repo actually publishes - commit messages among them, which is where ten
    # of our own names went out.
    NAME_TEST="$(dirname "$NAME_CHECK")/test_check_forbidden_names.py"
    if [ -f "$NAME_TEST" ] && ! python "$NAME_TEST"; then
        echo "" >&2
        echo "[pre-push] REFUSED - the name scanner's own cases are red, so its" >&2
        echo "[pre-push] verdict on this push would mean nothing." >&2
        exit 1
    fi

    if [ -n "$RANGE" ]; then
        echo "[pre-push] scanning files + the commit messages in $RANGE ..."
    else
        echo "[pre-push] scanning files for names we do not publish."
        echo "[pre-push] NOTE: no push range on stdin, so COMMIT MESSAGES were not"
        echo "[pre-push] scanned. A message cannot be reworded once it is pushed."
    fi
    if ! run_name_check; then
        echo "" >&2
        echo "[pre-push] REFUSED - see above. The offending files are named; the" >&2
        echo "[pre-push] tokens are not, so this log is safe to paste." >&2
        exit 1
    fi
fi

# ── publish gate (release tags only) ───────────────────────────────────
# Until 2026-07-27 this repo had NO gate: a release was a bare `twine upload`
# of whatever was in a directory. That is how 0.4.4 reached the index built
# from a tree that predated the fix it was supposed to carry - and a PyPI
# filename is never re-uploaded, so it is wrong forever.
#
# The gate lives in the core, which this package pins exactly, so it is always
# importable. `publish` builds and uploads WHAT IT JUST BUILT; that is the
# property that makes the failure above impossible.
#
# Only release tags are gated: the gate builds the project twice, and a hook
# that costs a minute on every push is a hook people delete.
release_tag=""
if [ -n "$PUSH_REFS" ]; then
    release_tag=$(printf '%s
' "$PUSH_REFS" | awk '
        $3 ~ /^refs\/tags\/v/ { print $3; exit }')
fi
if [ -n "$release_tag" ]; then
    echo "[pre-push] $release_tag is a release tag, running the publish gate..."
    if ! python -m invisible_core.release check --verify-index --project-root .; then
        echo "" >&2
        echo "[pre-push] REFUSED - see above. A version whose content moved needs a" >&2
        echo "[pre-push] new version number: a PyPI filename is never re-uploaded," >&2
        echo "[pre-push] so a wrong artifact stays wrong forever." >&2
        exit 1
    fi
fi

# The closing line never claims more than what actually ran.
if [ -n "$PIN_SKIPPED" ]; then
    echo "[pre-push] tests green, PIN GATE SKIPPED - push proceeding (see the warning above)."
else
    if [ -n "$NAME_SKIPPED" ]; then
        echo "[pre-push] tests green, pin matches, NAME SCAN SKIPPED - push proceeding."
    else
        echo "[pre-push] all tests green, pin matches, no forbidden names - push proceeding."
    fi
fi
exit 0
