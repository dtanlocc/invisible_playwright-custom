#!/bin/sh
# Pre-push hook: blocks push if the test suite isn't fully green.
#
# Enable once with:
#   git config core.hooksPath .githooks
#
# Bypass for a known-broken WIP push (NOT for releases):
#   git push --no-verify
# The --no-verify flag is the only escape hatch. Use it sparingly and never
# for branches that feed into a release.

set -e

echo "[pre-push] running unit + integration tests before push..."

# Run from this script's directory so it works regardless of where the user
# invoked git push from.
cd "$(dirname "$0")/.."

# Default pyproject addopts skip slow/e2e. That's the gate we want for every
# push, fast feedback. e2e is reserved for explicit release runs.
if ! python -m pytest -q --tb=short; then
    echo ""
    echo "[pre-push] TESTS FAILED - push aborted."
    echo "[pre-push] Either fix the failure or use 'git push --no-verify' if"
    echo "[pre-push] you really know what you're doing (NOT for release branches)."
    exit 1
fi

# The invisible-core== specifier in pyproject.toml must name the version the
# core checkout actually builds. The core's version is derived from its release
# seal, so it moves on its own when a new engine is rolled in; this pin does
# not. Checked here because a wrong pin is not visible to the test suite: it
# only shows up at install time, on someone else's machine.
#
# The checker lives in the local workbench, one level above this checkout, and
# is not part of this repository. It used to be wrapped in a bare
# `if [ -f "$PIN_CHECK" ]`, which skipped with NO output and then fell through
# to a line reading "all tests green - push proceeding". Renaming or moving the
# workbench, or pushing from a worktree at a different depth, disarmed the gate
# and printed something that looks exactly like success. A gate that cannot run
# is now a refusal, and the only way past it is to say so out loud.
PIN_CHECK="${INVISIBLE_PIN_CHECK:-../../scripts/sync_core_pin.py}"
PIN_SKIPPED=""

if [ "$INVISIBLE_PIN_CHECK" = "skip" ]; then
    echo ""
    echo "[pre-push] ###################################################################"
    echo "[pre-push] # WARNING: INVISIBLE_PIN_CHECK=skip                               #"
    echo "[pre-push] # The invisible-core pin was NOT compared against the core. If it #"
    echo "[pre-push] # is stale, every install of this package resolves a core it was  #"
    echo "[pre-push] # never tested against, and no test downstream can see it.        #"
    echo "[pre-push] ###################################################################"
    echo ""
    PIN_SKIPPED=yes
elif [ ! -f "$PIN_CHECK" ]; then
    echo "" >&2
    echo "[pre-push] REFUSED - the invisible-core pin gate is not reachable." >&2
    echo "[pre-push]   looked for: $PIN_CHECK" >&2
    echo "[pre-push]   from:       $(pwd)" >&2
    echo "[pre-push] The workbench moved, or this is a clone/worktree at another" >&2
    echo "[pre-push] depth. Point INVISIBLE_PIN_CHECK at sync_core_pin.py, or push" >&2
    echo "[pre-push] with INVISIBLE_PIN_CHECK=skip to state on the record that the" >&2
    echo "[pre-push] pin is going out unchecked." >&2
    exit 1
else
    # The gate's own known-bad cases, before the gate's verdict is trusted. They
    # live next to it and take about a second. Nothing else in either repo runs
    # them, so without this they are 18 cases that execute when a human
    # remembers - which is a runbook note wearing a gate's clothes, the same
    # shape as the silent skip above.
    PIN_TESTS="$(dirname "$PIN_CHECK")/test_sync_core_pin.py"
    if [ ! -f "$PIN_TESTS" ]; then
        echo "" >&2
        echo "[pre-push] REFUSED - $PIN_TESTS is missing, so the pin gate is" >&2
        echo "[pre-push] unverified. A gate that has only ever printed PASS is not a" >&2
        echo "[pre-push] gate; do not trust this one until its own cases run." >&2
        exit 1
    fi
    echo "[pre-push] running the pin gate's own known-bad cases..."
    if ! PIN_TEST_OUT="$(python "$PIN_TESTS" 2>&1)"; then
        echo "$PIN_TEST_OUT" >&2
        echo "" >&2
        echo "[pre-push] REFUSED - the pin gate's own test suite is RED, so its" >&2
        echo "[pre-push] verdict on the pin means nothing. Fix $PIN_TESTS first." >&2
        exit 1
    fi
    echo "[pre-push]   $(echo "$PIN_TEST_OUT" | tail -n 1)"

    echo "[pre-push] checking the invisible-core pin..."
    if ! python "$PIN_CHECK" --check; then
        echo ""
        echo "[pre-push] the invisible-core pin does not match the core - push aborted."
        echo "[pre-push] Fix it with: python $PIN_CHECK"
        exit 1
    fi
fi

# ── forbidden names ────────────────────────────────────────────────────
# Naming a commercial protection product, a proxy vendor or a target site in a
# public repo is a legal and credibility problem, and no test in this package
# covers it. It cannot be a test here either: the scanner needs a word list
# that deliberately lives outside every public repo, so a shipped test would
# fail closed on every user's clone with a failure they cannot fix - and a
# suite that is red by default gets pushed with --no-verify, which disarms
# every other gate in this file at the same time.
#
# So it is a workbench gate, resolved exactly like the pin check above: a gate
# that cannot be reached is a REFUSAL, never a silent pass.
NAME_CHECK="${INVISIBLE_NAME_CHECK:-../../scripts/check_forbidden_names.py}"
NAME_SKIPPED=""

if [ "$INVISIBLE_NAME_CHECK" = "skip" ]; then
    echo ""
    echo "[pre-push] ###################################################################"
    echo "[pre-push] # WARNING: INVISIBLE_NAME_CHECK=skip                              #"
    echo "[pre-push] # Nothing checked this push for vendor or target-site names. If   #"
    echo "[pre-push] # one is in the diff it is public the moment this lands, and a    #"
    echo "[pre-push] # force-push does not remove it - GitHub keeps the object.        #"
    echo "[pre-push] ###################################################################"
    echo ""
    NAME_SKIPPED=yes
elif [ ! -f "$NAME_CHECK" ]; then
    echo "" >&2
    echo "[pre-push] REFUSED - the forbidden-name gate is not reachable." >&2
    echo "[pre-push]   looked for: $NAME_CHECK" >&2
    echo "[pre-push]   from:       $(pwd)" >&2
    echo "[pre-push] Point INVISIBLE_NAME_CHECK at check_forbidden_names.py, or push" >&2
    echo "[pre-push] with INVISIBLE_NAME_CHECK=skip to state on the record that this" >&2
    echo "[pre-push] push is going out unscanned." >&2
    exit 1
else
    echo "[pre-push] scanning shipped files for names we do not publish..."
    # The script self-tests its matcher against a known-bad input built from
    # the live word list before it reports anything, and exits 2 rather than 0
    # whenever it could not do that. Any non-zero is a refusal here.
    if ! python "$NAME_CHECK" .; then
        echo "" >&2
        echo "[pre-push] REFUSED - see above. The offending files are named; the" >&2
        echo "[pre-push] tokens are not, so this log is safe to paste." >&2
        exit 1
    fi
fi

# The closing line never claims more than what actually ran.
if [ -n "$PIN_SKIPPED" ]; then
    echo "[pre-push] tests green, PIN GATE SKIPPED - push proceeding (see the warning above)."
else
    if [ -n "$NAME_SKIPPED" ]; then
        echo "[pre-push] tests green, pin matches, NAME SCAN SKIPPED - push proceeding."
    else
        echo "[pre-push] all tests green, pin matches, no forbidden names - push proceeding."
    fi
fi
exit 0
